post_upgrade() {
  if [ ! -e /etc/xrdp/rsakeys.ini ]; then
    umask 077
    xrdp-keygen xrdp /etc/xrdp/rsakeys.ini
  fi

  if [ ! -e /etc/xrdp/cert.pem ] || [ ! -e /etc/xrdp/key.pem ]; then
    umask 077
    openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 365 \
      -keyout /etc/xrdp/key.pem -out /etc/xrdp/cert.pem \
      -subj /CN=xrdp
    chmod 644 /etc/xrdp/cert.pem
  fi
}

post_install() {
  post_upgrade
}

pre_remove() {
  if [ -f /etc/xrdp/rsakeys.ini ]; then
    rm /etc/xrdp/rsakeys.ini
  fi
}
