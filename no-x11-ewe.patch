-    }
-
-    checkScreenLocked([this](bool locked) {
-        if (locked) {
-            // already locked, switch right away
-            m_displayManager.startReserve();
-            Q_EMIT startedNewSession();
-        } else {
-            m_pendingReserve = true;
-            m_pendingVt = 0;
-
-            Q_EMIT aboutToLockScreen();
-            m_screensaverInterface->Lock();
-        }
-    });
