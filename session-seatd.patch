+/*
+    SPDX-FileCopyrightText: 2025 Yukari Chiba <i@0x7f.cc>
+
+    SPDX-License-Identifier: GPL-2.0-or-later
+*/
+
+#include "session_seatd.h"
+
+#include "utils/common.h"
+
+#include <QMutexLocker>
+#include <QSocketNotifier>
+#include <QString>
+
+#include <cerrno>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+extern "C" {
+#include <libseat.h>
+}
+
+namespace KWin
+{
+
+void SeatdSession::onEnableSeat(struct libseat *seat, void *userdata)
+{
+    Q_UNUSED(seat)
+    if (auto session = static_cast<SeatdSession *>(userdata)) {
+        session->handleEnableSeat();
+    }
+}
+
+void SeatdSession::onDisableSeat(struct libseat *seat, void *userdata)
+{
+    Q_UNUSED(seat)
+    if (auto session = static_cast<SeatdSession *>(userdata)) {
+        session->handleDisableSeat();
+    }
+}
+
+std::unique_ptr<SeatdSession> SeatdSession::create()
+{
+    auto session = std::unique_ptr<SeatdSession>(new SeatdSession(nullptr));
+
+    static const struct libseat_seat_listener listener = {
+        .enable_seat = &SeatdSession::onEnableSeat,
+        .disable_seat = &SeatdSession::onDisableSeat,
+    };
+
+    struct libseat *seat = libseat_open_seat(&listener, session.get());
+    if (!seat) {
+        qCWarning(KWIN_CORE) << "Failed to open libseat seat:" << strerror(errno);
+        return nullptr;
+    }
+
+    session->m_seat = seat;
+
+    if (!session->initialize()) {
+        return nullptr;
+    }
+
+    return session;
+}
+
+SeatdSession::SeatdSession(struct libseat *seat)
+    : m_seat(seat)
+{
+}
+
+bool SeatdSession::initialize()
+{
+    const int fd = libseat_get_fd(m_seat);
+    if (fd < 0) {
+        qCWarning(KWIN_CORE) << "Failed to get libseat fd:" << strerror(errno);
+        return false;
+    }
+
+    m_notifier = new QSocketNotifier(fd, QSocketNotifier::Read, this);
+    connect(m_notifier, &QSocketNotifier::activated, this, &SeatdSession::handleSeatdEvents);
+
+    {
+        QMutexLocker locker(&m_mutex);
+        while (libseat_dispatch(m_seat, 0) > 0) {
+        }
+    }
+    processPendingEvents();
+
+    return true;
+}
+
+SeatdSession::~SeatdSession()
+{
+    QMutexLocker locker(&m_mutex);
+    if (m_seat) {
+        libseat_close_seat(m_seat);
+    }
+}
+
+bool SeatdSession::isActive() const
+{
+    QMutexLocker locker(&m_mutex);
+    return m_isActive;
+}
+
+Session::Capabilities SeatdSession::capabilities() const
+{
+    return Capability::SwitchTerminal;
+}
+
+QString SeatdSession::seat() const
+{
+    QMutexLocker locker(&m_mutex);
+    const char *name = libseat_seat_name(m_seat);
+    return name ? QString::fromUtf8(name) : QStringLiteral("seat0");
+}
+
+uint SeatdSession::terminal() const
+{
+    return 0;
+}
+
+std::expected<int, Session::Error> SeatdSession::openRestricted(const QString &fileName)
+{
+    QMutexLocker locker(&m_mutex);
+    if (!m_isActive) {
+        errno = EAGAIN;
+        qCWarning(KWIN_CORE) << "Cannot open restricted device when session is not active.";
+        return -1;
+    }
+
+    const QByteArray path = fileName.toUtf8();
+    int fd = -1;
+    const int deviceId = libseat_open_device(m_seat, path.constData(), &fd);
+    if (deviceId < 0) {
+        qCWarning(KWIN_CORE) << "libseat_open_device for" << fileName << "failed:" << strerror(errno);
+        // Some seatd deployments cannot re-open devices after a session switch.
+        return open(path.constData(), O_RDWR | O_CLOEXEC);
+    }
+
+    const int flags = fcntl(fd, F_GETFD);
+    if (flags != -1) {
+        fcntl(fd, F_SETFD, flags | FD_CLOEXEC);
+    } else {
+        qCWarning(KWIN_CORE) << "fcntl(F_GETFD) failed for new device fd:" << strerror(errno);
+    }
+
+    m_fileDescriptors.insert(fd, deviceId);
+    return fd;
+}
+
+void SeatdSession::closeRestricted(int fileDescriptor)
+{
+    QMutexLocker locker(&m_mutex);
+    auto it = m_fileDescriptors.find(fileDescriptor);
+    if (it != m_fileDescriptors.end()) {
+        libseat_close_device(m_seat, it.value());
+        m_fileDescriptors.erase(it);
+        ::close(fileDescriptor);
+    } else {
+        qCWarning(KWIN_CORE) << "Closing unknown restricted fd" << fileDescriptor;
+        ::close(fileDescriptor);
+    }
+}
+
+void SeatdSession::switchTo(uint terminal)
+{
+    QMutexLocker locker(&m_mutex);
+    if (libseat_switch_session(m_seat, terminal) != 0) {
+        qCWarning(KWIN_CORE) << "libseat_switch_session failed:" << strerror(errno);
+    }
+}
+
+std::shared_ptr<FileDescriptor> SeatdSession::delaySleep(const QString &reason)
+{
+    Q_UNUSED(reason)
+    return nullptr;
+}
+
+void SeatdSession::handleSeatdEvents()
+{
+    {
+        QMutexLocker locker(&m_mutex);
+        const int ret = libseat_dispatch(m_seat, 0);
+        if (ret == -1 && errno != EAGAIN) {
+            qCWarning(KWIN_CORE) << "libseat_dispatch failed:" << strerror(errno);
+            m_notifier->setEnabled(false);
+        }
+    }
+    processPendingEvents();
+}
+
+void SeatdSession::handleEnableSeat()
+{
+    QMutexLocker locker(&m_mutex);
+    if (m_isActive) {
+        return;
+    }
+
+    qCDebug(KWIN_CORE) << "Seatd session enabled.";
+    m_isActive = true;
+
+    PendingEvent event{true, {}};
+    for (auto it = m_fileDescriptors.constBegin(); it != m_fileDescriptors.constEnd(); ++it) {
+        struct stat st;
+        if (fstat(it.key(), &st) == 0) {
+            event.devices.append(st.st_rdev);
+        }
+    }
+    m_pendingEvents.append(event);
+}
+
+void SeatdSession::handleDisableSeat()
+{
+    QMutexLocker locker(&m_mutex);
+    if (m_isActive) {
+        qCDebug(KWIN_CORE) << "Seatd session disabled.";
+        m_isActive = false;
+
+        PendingEvent event{false, {}};
+        for (auto it = m_fileDescriptors.constBegin(); it != m_fileDescriptors.constEnd(); ++it) {
+            struct stat st;
+            if (fstat(it.key(), &st) == 0) {
+                event.devices.append(st.st_rdev);
+            }
+        }
+        m_pendingEvents.append(event);
+    }
+
+    if (libseat_disable_seat(m_seat) != 0) {
+        qCWarning(KWIN_CORE) << "libseat_disable_seat failed:" << strerror(errno);
+    }
+}
+
+void SeatdSession::processPendingEvents()
+{
+    QList<PendingEvent> events;
+    {
+        QMutexLocker locker(&m_mutex);
+        events.swap(m_pendingEvents);
+    }
+
+    for (const PendingEvent &event : events) {
+        if (event.enabled) {
+            for (dev_t device : event.devices) {
+                Q_EMIT deviceResumed(device);
+            }
+            Q_EMIT activeChanged(true);
+        } else {
+            for (dev_t device : event.devices) {
+                Q_EMIT devicePaused(device);
+            }
+            Q_EMIT activeChanged(false);
+        }
+    }
+}
+
+} // namespace KWin
+
