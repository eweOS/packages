From 4b8965e66be00a2fd2c16b9ed5098c2550aa0e65 Mon Sep 17 00:00:00 2001
From: Yao Zi <me@ziyao.cc>
Date: Wed, 25 Nov 2026 16:07:01 +0000
Subject: [PATCH] [llvm][cmake] Try LLVM libunwind when frame registration is
 unavailable

Different from libgcc, compiler-rt doesn't provide unwind-related
symbols by itself, and expects libunwind to do the job. In this case
checks against __register_frame, __deregister_frame, and
__unw_add_dynamic_fde would always fail without linking other libraries.

When all of these three symbols are missing, try finding
__unw_add_dynamic_fde in libunwind, consider LLVM libunwind should be
explicitly linked if succeeds.

Signed-off-by: Yao Zi <me@ziyao.cc>
---
 llvm/cmake/config-ix.cmake | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/llvm/cmake/config-ix.cmake b/llvm/cmake/config-ix.cmake
index a8e4e5a63244..fde32aefdc47 100644
--- a/llvm/cmake/config-ix.cmake
+++ b/llvm/cmake/config-ix.cmake
@@ -357,6 +357,15 @@ endif()
 check_symbol_exists(__register_frame "${CMAKE_CURRENT_LIST_DIR}/unwind.h" HAVE_REGISTER_FRAME)
 check_symbol_exists(__deregister_frame "${CMAKE_CURRENT_LIST_DIR}/unwind.h" HAVE_DEREGISTER_FRAME)
 check_symbol_exists(__unw_add_dynamic_fde "${CMAKE_CURRENT_LIST_DIR}/unwind.h" HAVE_UNW_ADD_DYNAMIC_FDE)
+if (NOT (HAVE_REGISTER_FRAME OR HAVE_DEREGISTER_FRAME OR HAVE_UNW_ADD_DYNAMIC_FDE))
+  check_library_exists(unwind __unw_add_dynamic_fde "" HAVE_LLVM_LIBUNWIND)
+  if (HAVE_LLVM_LIBUNWIND)
+    list(APPEND CMAKE_REQUIRED_LIBRARIES "unwind")
+    set(HAVE_UNW_ADD_DYNAMIC_FDE 1)
+    set(HAVE_REGISTER_FRAME 1)
+    set(HAVE_DEREGISTER_FRAME 1)
+  endif ()
+endif ()
 
 check_symbol_exists(_Unwind_Backtrace "unwind.h" HAVE__UNWIND_BACKTRACE)
 check_symbol_exists(getpagesize unistd.h HAVE_GETPAGESIZE)
